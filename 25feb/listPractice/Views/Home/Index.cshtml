@{
    var directions = new[] { "left", "right", "up", "down" };
    var messages = new[]
    {
        "🚨 Sukrutha detected!",
        "😂 System overload!",
        "🔥 Too glam to stop!",
        "👀 Why are you reading this?",
        "💃 Chaos level: MAX",
        "🚀 Zoom zoom!",
        "🎯 Mission Sukrutha",
        "😎 Certified legend"
    };

    var rand = new Random();
}

<style>
    .chaos-text {
        font-size: 30px;
        font-weight: bold;
        margin-right: 60px;
        display: inline-block;
        animation: spin 2s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg) scale(1); }
        50% { transform: rotate(180deg) scale(1.3); }
        100% { transform: rotate(360deg) scale(1); }
    }

    .rainbow-bg {
        background: linear-gradient(90deg, red, orange, yellow, green, blue, indigo, violet);
        background-size: 400% 400%;
        animation: rainbowMove 3s linear infinite;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 12px;
    }

    @@keyframes rainbowMove {
        0% { background-position: 0% 50%; }
        100% { background-position: 100% 50%; }
    }
</style>

<h1 style="text-align:center;">😈 CHAOS MODE ACTIVATED 😈</h1>
@foreach (var dir in directions)
{
    var speed = rand.Next(4, 15);
    <div class="rainbow-bg">
        <marquee direction="@dir"
                 behavior="alternate"
                 scrollamount="@speed"
                 height="120"
                 onmouseover="this.stop()"
                 onmouseout="this.start()">

            @foreach (var msg in messages.OrderBy(x => rand.Next()))
            {
                <span class="chaos-text">
                    @msg
                </span>
            }
        </marquee>
    </div>
}