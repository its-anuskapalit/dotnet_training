@model IEnumerable<StudentPortalMVC.Models.Course>
<div class="container mt-4">
    <div class="section-card">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="page-header">📘 Courses</div>
            <a asp-action="Create" class="btn btn-outline-light">
                + Add Course
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <!-- FILTER -->
        <div class="section-card mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" id="searchBox"
                           class="form-control"
                           placeholder="🔍 Search courses..." />
                </div>

                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Duration</th>
                        <th>Fee</th>
                        <th>Level</th>
                        <th>Status</th>
                        <th width="220">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Title</td>
                            <td>@item.DurationDays days</td>
                            <td>₹ @item.Fee</td>
                            <td>@item.Level</td>

                            <td>
                                <span class="course-status d-none">
                                    @(item.IsActive.ToString().ToLower())
                                </span>

                                <div class="form-check form-switch">
                                    <input class="form-check-input status-toggle"
                                           type="checkbox"
                                           data-id="@item.CourseId"
                                           @(item.IsActive ? "checked" : "")>
                                </div>
                            </td>

                            <td>
                                <a asp-action="Edit" asp-route-id="@item.CourseId"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <a href="#" class="btn btn-sm btn-danger delete-btn"
                                   data-id="@item.CourseId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>
@section Scripts {
<script>
    console.log("COURSE SCRIPT LOADED");
$(searchBox).on("change", ".status-toggle", function () {
    const checkbox = $(this);
    const id = checkbox.data("id");
    const isActive = checkbox.is(":checked");

    $.ajax({
        url: '/Courses/ToggleStatus',
        type: 'POST',
        data: { id: id, isActive: isActive },
        success: function (res) {
            if (!res.success) {
                Swal.fire("Error", "Failed to update status", "error");
                checkbox.prop("checked", !isActive);
            }
        },
        error: function () {
            Swal.fire("Error", "Server error", "error");
            checkbox.prop("checked", !isActive);
        }
    });
});
</script>
}