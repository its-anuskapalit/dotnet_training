@model StudentPortalMVC.Models.Course

<div class="container mt-4">
     <div class="glass-card p-4">
    <div class="card app-card shadow-sm">
        <div class="card-header">Edit Course</div>
        <div class="card-body">

        <form asp-action="Edit" method="post">

            <!-- 🔴 CRITICAL -->
            <input type="hidden" asp-for="CourseId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DurationDays" class="form-label"></label>
                <input asp-for="DurationDays" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Fee" class="form-label"></label>
                <input asp-for="Fee" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Level" class="form-label"></label>
                <select asp-for="Level" class="form-select">
                    <option>Beginner</option>
                    <option>Intermediate</option>
                    <option>Advanced</option>
                </select>
            </div>

            <button class="btn btn-success">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>

        </form>

    </div>
</div>
</div>
</div>
