@model List<StudentPortalMVC.Models.Student>

@{
    ViewData["Title"] = "Students";
    var q = (ViewBag.Query as string) ?? "";
}

<div class="container mt-4">

    <div class="glass-card">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="page-title">👥 Students</div>
            <a asp-action="Create" class="btn btn-gradient">
                + Add Student
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <!-- LIVE SEARCH -->
        <div class="sub-card p-3 mb-4">
            <div class="row g-3">

                <div class="col-md-4">
                    <input id="q"
                           value="@q"
                           class="form-control"
                           placeholder="🔍 Search students..." />
                </div>

                <div class="col-md-2">
                    <button id="btnSearch" class="btn btn-gradient w-100" type="button">
                        Search
                    </button>
                </div>

            </div>

            <div id="liveBox" class="small text-muted mt-2"></div>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th width="220">Actions</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    @foreach (var item in Model)
                    {
                        var statusText = (item.Status ?? "").ToLower();
                        <tr>
                            <td>@item.StudentId</td>
                            <td class="fw-medium">@item.FullName</td>
                            <td>@item.Email</td>

                            <td>
                                <span class="student-status d-none">@statusText</span>

                                <div class="form-check form-switch">
                                    <input class="form-check-input status-toggle"
                                           type="checkbox"
                                           data-id="@item.StudentId"
                                           @(statusText == "active" ? "checked" : "")>
                                </div>
                            </td>

                            <td>
                                <a asp-action="Edit" asp-route-id="@item.StudentId"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <a href="#" class="btn btn-sm btn-danger delete-btn"
                                   data-id="@item.StudentId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

@section Scripts{
<script>
const qEl = document.getElementById("q");
const box = document.getElementById("liveBox");
const tbody = document.getElementById("tblBody");
const btn = document.getElementById("btnSearch");

let t = null;

function renderRows(items){
    if(!items || items.length === 0){
        tbody.innerHTML = `<tr><td colspan="5">No results</td></tr>`;
        return;
    }

    tbody.innerHTML = items.map(s => `
        <tr>
            <td>${s.studentId}</td>
            <td class="fw-medium">${s.fullName}</td>
            <td>${s.email}</td>
            <td>
                <div class="form-check form-switch">
                    <input class="form-check-input status-toggle"
                           type="checkbox"
                           data-id="${s.studentId}"
                           ${s.status?.toLowerCase() === "active" ? "checked" : ""}>
                </div>
            </td>
            <td>
                <a class="btn btn-sm btn-warning" href="/Students/Edit/${s.studentId}">Edit</a>
                <a class="btn btn-sm btn-danger delete-btn" data-id="${s.studentId}" href="#">Delete</a>
            </td>
        </tr>
    `).join("");
}

async function liveSearch(){
    const q = qEl.value.trim();

    if(q.length === 0){
        box.textContent = "";
        return;
    }

    box.textContent = "Searching...";

    const res = await fetch(`/Students/Search?q=${encodeURIComponent(q)}`);
    const data = await res.json();

    box.textContent = `Found: ${data.length}`;
    renderRows(data);
}

// debounce typing
qEl.addEventListener("keyup", () => {
    clearTimeout(t);
    t = setTimeout(liveSearch, 300);
});

btn.addEventListener("click", liveSearch);

// ================= TOGGLE STATUS =================
$(document).on("change", ".status-toggle", function () {
    const checkbox = $(this);
    const id = checkbox.data("id");
    const isActive = checkbox.is(":checked");

    $.ajax({
        url: '/Students/ToggleStatus',
        type: 'POST',
        data: { id: id, isActive: isActive },
        success: function (res) {
            if (!res.success) {
                Swal.fire("Error", res.message || "Failed to update status", "error");
                checkbox.prop("checked", !isActive);
            }
        },
        error: function () {
            Swal.fire("Error", "Server error", "error");
            checkbox.prop("checked", !isActive);
        }
    });
});

// ================= DELETE =================
$(document).on("click", ".delete-btn", function (e) {
    e.preventDefault();
    const id = $(this).data("id");

    Swal.fire({
        title: "Delete Student?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete"
    }).then(result => {
        if (result.isConfirmed) {
            window.location.href = '/Students/Delete/' + id;
        }
    });
});
</script>
}