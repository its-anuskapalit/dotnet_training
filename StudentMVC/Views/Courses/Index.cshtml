@model IEnumerable<StudentPortalMvc.Models.Course>

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2 class="text-primary">Courses</h2>
        <a asp-action="Create" class="btn btn-success">+ Add Course</a>
    </div>

    <table class="table table-striped table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Duration</th>
                <th>Fee</th>
                <th>Level</th>
                <th>Status</th>
                <th width="180">Actions</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model)
{
            <tr>
                <td>@item.Title</td>
                <td>@item.DurationDays days</td>
                <td>₹@item.Fee</td>
                <td>@item.Level</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>