<div class="container mt-4">

    <div class="glass-card">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="page-title">👥 Students</div>
            <a asp-action="Create" class="btn btn-gradient">
                + Add Student
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <!-- FILTER CARD -->
        <div class="sub-card p-3 mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" id="searchBox"
                           class="form-control"
                           placeholder="🔍 Search students..." />
                </div>

                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th width="220">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusText = (item.Status ?? "").ToLower();
                        <tr>
                            <td class="fw-medium">@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>

                            <td>
                                <span class="student-status d-none">@statusText</span>

                                <div class="form-check form-switch">
                                    <input class="form-check-input status-toggle"
                                           type="checkbox"
                                           data-id="@item.StudentId"
                                           @(statusText == "active" ? "checked" : "")>
                                </div>
                            </td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.StudentId"
                                   class="btn btn-sm btn-info">View</a>

                                <a asp-action="Edit" asp-route-id="@item.StudentId"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <a href="#" class="btn btn-sm btn-danger delete-btn"
                                   data-id="@item.StudentId">
                                   Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>