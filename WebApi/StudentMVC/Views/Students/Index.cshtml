@model IEnumerable<StudentMVC.Models.Student>

<h2>Students</h2>

<a href="/Students/Create">Add Student</a>

<table border="1">
<tr>
<th>Name</th>
<th>Email</th>
<th>Phone</th>
<th>Actions</th>
</tr>

@foreach (var s in Model)
{
<tr>
<td>@s.FullName</td>
<td>@s.Email</td>
<td>@s.Phone</td>
<td>
<a href="/Students/Edit/@s.StudentId">Edit</a>
<a href="/Students/Delete/@s.StudentId">Delete</a>
</td>
</tr>
}

</table>